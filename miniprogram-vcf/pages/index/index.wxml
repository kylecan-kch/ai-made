<view class="page">
  <!-- 顶部说明 -->
  <view class="hero">
    <view class="hero-title">VCF 通讯录 ↔ 表格 互转</view>
    <view class="hero-sub">支持 vCard 2.1 / 3.0 / 4.0、Quoted-Printable、中文姓名、GBK 编码；表格支持 CSV / Excel</view>
    <view class="stats row">
      <view class="stat"><text class="stat-num">{{total}}</text><text class="stat-label">联系人</text></view>
      <view class="stat"><text class="stat-num">{{selectedCount}}</text><text class="stat-label">已勾选</text></view>
    </view>
  </view>

  <!-- 导入 -->
  <view class="card">
    <view class="card-title">① 导入</view>
    <view class="muted">从微信聊天中选择 .vcf / .csv / .xlsx 文件（可先把文件发到“文件传输助手”）</view>

    <picker mode="selector" range="{{importModes}}" value="{{importModeIndex}}" bindchange="onImportModeChange">
      <view class="picker-line">导入方式：<text class="picker-value">{{importModes[importModeIndex]}}</text><text class="arrow">▾</text></view>
    </picker>

    <view class="row wrap">
      <button class="btn btn-primary" bindtap="chooseFile">选择文件</button>
      <button class="btn" bindtap="togglePaste">{{showPaste ? '收起粘贴' : '粘贴文本'}}</button>
      <button class="btn btn-plain" bindtap="loadDemo">载入示例</button>
      <button class="btn btn-plain" bindtap="downloadTemplate">下载标准模板</button>
    </view>

    <view wx:if="{{showPaste}}" class="paste-box">
      <textarea class="paste-area" value="{{pasteText}}" bindinput="onPasteInput" maxlength="-1"
        placeholder="在此粘贴 BEGIN:VCARD … END:VCARD 内容，或带表头的 CSV 文本" auto-height="{{false}}" />
      <view class="row wrap">
        <button class="btn btn-primary" bindtap="parsePasted">解析</button>
        <button class="btn btn-plain" bindtap="pasteFromClipboard">从剪贴板读取</button>
      </view>
    </view>

    <view wx:if="{{lastImport}}" class="notice">{{lastImport}}</view>
  </view>

  <!-- 联系人 -->
  <view class="card">
    <view class="row between">
      <view class="card-title">② 预览与整理</view>
      <view class="seg row">
        <view class="seg-item {{viewMode === 'list' ? 'seg-on' : ''}}" data-mode="list" bindtap="switchView">列表</view>
        <view class="seg-item {{viewMode === 'table' ? 'seg-on' : ''}}" data-mode="table" bindtap="switchView">表格</view>
      </view>
    </view>

    <view wx:if="{{total === 0}}" class="empty">
      <view>还没有联系人</view>
      <view class="muted">点击上方“选择文件”导入，或“载入示例”体验</view>
    </view>

    <block wx:else>
      <view class="search row">
        <input class="search-input" value="{{keyword}}" placeholder="搜索姓名 / 电话 / 公司 / 邮箱 / 标签" confirm-type="search" bindinput="onSearchInput" />
        <text wx:if="{{keyword}}" class="search-clear" bindtap="clearSearch">✕</text>
      </view>

      <view class="row between toolbar">
        <view class="row" bindtap="toggleSelectAll">
          <view class="checkbox {{allSelected ? 'checkbox-on' : ''}}">{{allSelected ? '✓' : ''}}</view>
          <text class="muted">全选（{{filteredTotal}} 位{{keyword ? '匹配' : ''}}）</text>
        </view>
        <view class="row">
          <button class="btn btn-mini" bindtap="runDedupe">查重合并</button>
          <button class="btn btn-mini btn-danger" bindtap="clearAll">清空</button>
        </view>
      </view>

      <!-- 列表视图 -->
      <view wx:if="{{viewMode === 'list'}}">
        <view wx:for="{{list}}" wx:key="id" class="contact {{item.id === expandedId ? 'contact-open' : ''}}">
          <view class="row contact-head">
            <view class="checkbox {{item.checked ? 'checkbox-on' : ''}}" data-id="{{item.id}}" catchtap="toggleSelect">{{item.checked ? '✓' : ''}}</view>
            <view class="avatar">{{item.avatar}}</view>
            <view class="contact-main" data-id="{{item.id}}" bindtap="toggleExpand">
              <view class="contact-name">{{item.name}}</view>
              <view class="muted ellipsis">{{item.firstPhone || '无电话'}}<text wx:if="{{item.phoneCount > 1}}"> 等 {{item.phoneCount}} 个号码</text><text wx:if="{{item.subtitle}}"> · {{item.subtitle}}</text></view>
            </view>
            <text class="arrow" data-id="{{item.id}}" bindtap="toggleExpand">{{item.id === expandedId ? '▴' : '▾'}}</text>
          </view>

          <view wx:if="{{item.id === expandedId}}" class="detail">
            <view wx:for="{{item.phones}}" wx:for-item="p" wx:for-index="pi" wx:key="pi" class="kv">
              <text class="k">{{p.type}}</text>
              <text class="v link" data-number="{{p.number}}" bindtap="callPhone">{{p.number}}</text>
            </view>
            <view wx:for="{{item.emails}}" wx:for-item="m" wx:for-index="mi" wx:key="mi" class="kv">
              <text class="k">邮箱·{{m.type}}</text><text class="v" user-select>{{m.address}}</text>
            </view>
            <view wx:if="{{item.subtitle}}" class="kv"><text class="k">单位</text><text class="v">{{item.subtitle}}</text></view>
            <view wx:if="{{item.address}}" class="kv"><text class="k">地址</text><text class="v">{{item.address}}</text></view>
            <view wx:if="{{item.birthday}}" class="kv"><text class="k">生日</text><text class="v">{{item.birthday}}</text></view>
            <view wx:if="{{item.website}}" class="kv"><text class="k">网址</text><text class="v" user-select>{{item.website}}</text></view>
            <view wx:if="{{item.notes}}" class="kv"><text class="k">备注</text><text class="v">{{item.notes}}</text></view>
            <view wx:if="{{item.categories.length}}" class="kv">
              <text class="k">标签</text>
              <view class="v row wrap"><text wx:for="{{item.categories}}" wx:for-item="t" wx:key="*this" class="tag">{{t}}</text></view>
            </view>
            <view class="row wrap actions">
              <button class="btn btn-mini btn-primary" data-id="{{item.id}}" bindtap="addToPhone">存入手机通讯录</button>
              <button class="btn btn-mini" data-id="{{item.id}}" bindtap="copyContact">复制 vCard</button>
              <button class="btn btn-mini btn-danger" data-id="{{item.id}}" bindtap="deleteContact">删除</button>
            </view>
          </view>
        </view>
      </view>

      <!-- 表格视图（格式1） -->
      <scroll-view wx:else scroll-x="{{true}}" class="table-scroll">
        <view class="table">
          <view class="tr th">
            <view class="td td-check"></view>
            <view wx:for="{{columns}}" wx:key="*this" class="td">{{item}}</view>
          </view>
          <view wx:for="{{tableRows}}" wx:for-item="r" wx:key="id" class="tr">
            <view class="td td-check" data-id="{{r.id}}" bindtap="toggleSelect">
              <view class="checkbox checkbox-sm {{r.checked ? 'checkbox-on' : ''}}">{{r.checked ? '✓' : ''}}</view>
            </view>
            <view wx:for="{{r.cells}}" wx:for-item="cell" wx:for-index="ci" wx:key="ci" class="td">{{cell}}</view>
          </view>
        </view>
      </scroll-view>

      <view wx:if="{{hasMore}}" class="more" bindtap="loadMore">已显示部分，点击或上滑加载更多</view>
    </block>
  </view>

  <!-- 导出 -->
  <view class="card">
    <view class="card-title">③ 导出</view>
    <picker mode="selector" range="{{formats}}" value="{{formatIndex}}" bindchange="onFormatChange">
      <view class="picker-line">导出格式：<text class="picker-value">{{formats[formatIndex]}}</text><text class="arrow">▾</text></view>
    </picker>
    <block wx:if="{{formatIndex === 0}}">
      <picker mode="selector" range="{{versions}}" value="{{versionIndex}}" bindchange="onVersionChange">
        <view class="picker-line">vCard 版本：<text class="picker-value">{{versions[versionIndex]}}</text><text class="arrow">▾</text></view>
      </picker>
      <picker mode="selector" range="{{encodings}}" value="{{encodingIndex}}" bindchange="onEncodingChange">
        <view class="picker-line">字符编码：<text class="picker-value">{{encodings[encodingIndex]}}</text><text class="arrow">▾</text></view>
      </picker>
    </block>
    <picker mode="selector" range="{{scopes}}" value="{{scopeIndex}}" bindchange="onScopeChange">
      <view class="picker-line">导出范围：<text class="picker-value">{{scopes[scopeIndex]}}</text><text class="arrow">▾</text></view>
    </picker>

    <button class="btn btn-primary btn-block" bindtap="doExport" disabled="{{total === 0}}">
      生成文件（{{scopeIndex === 1 ? selectedCount : total}} 人）
    </button>

    <view wx:if="{{exported}}" class="export-box">
      <view class="export-name">📄 {{exported.fileName}}</view>
      <view class="muted">{{exported.count}} 位联系人，已保存在小程序本地目录</view>
      <view class="row wrap">
        <button class="btn btn-primary" bindtap="shareExported">发送给好友 / 文件传输助手</button>
        <button wx:if="{{exported.canOpen}}" class="btn" bindtap="openExported">打开预览</button>
        <button wx:if="{{exported.canCopy}}" class="btn btn-plain" bindtap="copyExported">复制内容</button>
      </view>
    </view>

    <view class="tips muted">
      <view>· 导入手机通讯录：把 .vcf 发送到“文件传输助手”，在手机上用“其他应用打开”选择通讯录即可批量导入。</view>
      <view>· 老款安卓或 Outlook 乱码时，选择 vCard 2.1 + Quoted-Printable。</view>
      <view>· CSV 已带 UTF-8 BOM，用 Excel 打开中文不乱码。</view>
    </view>
  </view>

  <view class="footer muted">数据仅保存在本机，不会上传到任何服务器</view>
</view>
