page {
  background: #f1f5f9;
  color: #0f172a;
  font-size: 28rpx;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", "Microsoft YaHei", sans-serif;
  line-height: 1.5;
}
.card {
  background: #ffffff;
  border-radius: 20rpx;
  margin: 24rpx;
  padding: 28rpx;
  box-shadow: 0 2rpx 8rpx rgba(15, 23, 42, 0.05);
}
.card-title {
  font-size: 32rpx;
  font-weight: 600;
  margin-bottom: 8rpx;
}
.muted { color: #64748b; font-size: 24rpx; }
.row { display: flex; flex-direction: row; align-items: center; }
.wrap { flex-wrap: wrap; }
.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  height: 72rpx;
  padding: 0 28rpx;
  margin: 8rpx 16rpx 8rpx 0;
  border-radius: 14rpx;
  width: auto !important;
  min-width: 0;
  font-weight: 500;
  font-size: 26rpx;
  background: #eff6ff;
  color: #1d4ed8;
  line-height: 72rpx;
}
.btn::after { border: none; }
.btn-primary { background: #2563eb; color: #ffffff; }
.btn-danger { background: #fef2f2; color: #dc2626; }
.btn-plain { background: #f1f5f9; color: #334155; }
.btn[disabled] { opacity: 0.5; }
